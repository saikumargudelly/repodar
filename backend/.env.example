# GitHub API
GITHUB_TOKEN=your_github_personal_access_token_here

# LLM Providers Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

CEREBRAS_API_KEY=your_cerebras_api_key_here
CEREBRAS_MODEL=llama3.1-70b

# Groq LLM (Final fallback)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Fallback chain order (comma separated, priority left-to-right)
LLM_PROVIDER_ORDER=gemini,cerebras,groq


# Database (SQLite for local, swap to postgres+psycopg2 for prod)
DATABASE_URL=sqlite:///./repodar.db

# Redis (optional — used for API response caching via fastapi-cache2; falls back to in-memory if unset)
REDIS_URL=redis://localhost:6379/0

# Email delivery (Resend — required for digest emails and watchlist alert emails)
RESEND_API_KEY=re_your_resend_api_key_here

# Admin API key (required for /admin/* endpoints and the GitHub Actions sync workflow)
ADMIN_SECRET_KEY=your_admin_secret_here

# In-app APScheduler (set to true to run enrichment, snapshots, and digest jobs inside the web process)
# When false (default), use the GitHub Actions workflow (.github/workflows/sync.yml) for scheduling.
ENABLE_IN_APP_SCHEDULER=false

# App
APP_ENV=development
LOG_LEVEL=INFO

