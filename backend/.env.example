# GitHub API
GITHUB_TOKEN=your_github_personal_access_token_here

# LLM Providers Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

CEREBRAS_API_KEY=your_cerebras_api_key_here
CEREBRAS_MODEL=llama3.1-70b

# Groq LLM (Final fallback)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Fallback chain order (comma separated, priority left-to-right)
LLM_PROVIDER_ORDER=gemini,cerebras,groq


# Database (SQLite for local, swap to postgres+psycopg2 for prod)
DATABASE_URL=sqlite:///./repodar.db

# Redis (Celery broker + backend)
REDIS_URL=redis://localhost:6379/0

# App
APP_ENV=development
LOG_LEVEL=INFO
